# Circle user-controlled wallets
CIRCLE_API_KEY=
VITE_CIRCLE_APP_ID=

# Same client id as Circle → Wallets → User Controlled → Social Logins
# Redirect URI is the app origin (http://localhost:5174 locally)
VITE_GOOGLE_CLIENT_ID=

# Modular Wallets passkey. Console → Keys → Client Key, then set the passkey domain.
VITE_CIRCLE_CLIENT_KEY=
VITE_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl

# mainnet matches the deployed Stablegram contracts. testnet will not see those names.
ARC_NETWORK=mainnet
VITE_ARC_NETWORK=mainnet

# Telegram. The bot answers /start through the Vercel webhook at /api/telegram.
TELEGRAM_BOT_TOKEN=
VITE_MINI_APP_URL=http://localhost:5174
VITE_BOT_USERNAME=stablegram_bot

# Server-only. Pays gas for Google name claims. Never expose this to the client.
RELAYER_PRIVATE_KEY=

# Contract deploy (contracts/.env)
# PRIVATE_KEY=
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
